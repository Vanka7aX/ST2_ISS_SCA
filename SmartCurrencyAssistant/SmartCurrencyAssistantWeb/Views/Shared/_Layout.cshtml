<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Currency Assistant</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header"><nav class="site-nav" aria-label="Основна навигация"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark" aria-hidden="true">S</span><span>Smart Currency <small>Assistant</small></span></a><div class="nav-links"><a asp-controller="Home" asp-action="Index">Конвертор</a><a asp-controller="Home" asp-action="Analysis">Анализ</a><a asp-controller="Home" asp-action="History">История</a></div></nav></header>
    <main role="main" class="site-main">@RenderBody()</main>
    <footer class="site-footer"><div><span>© 2026 Smart Currency Assistant</span></div></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
