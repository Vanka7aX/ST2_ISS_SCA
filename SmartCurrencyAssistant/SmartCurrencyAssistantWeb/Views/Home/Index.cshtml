@{
    ViewData["Title"] = "SmartCurrencyAssistant";
}

<div class="container py-4">
    <h2>SmartCurrencyAssistant</h2>
    <p>Basic Frontend - Backend Testing</p>

    <hr />
    <div class="converter-section">
        <h4>Валутен асистент</h4>
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label class="form-label">От валута</label>
                <select id="fromCurrency" class="form-select">
                    <option value="EUR">EUR</option>
                    <option value="USD">USD</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Към валута</label>
                <select id="toCurrency" class="form-select">
                    <option value="USD">USD</option>
                    <option value="EUR">EUR</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Сума</label>
                <input id="amount" type="number" class="form-control" value="100" min="0.01" step="0.01" />
            </div>
        </div>

        <button class="btn btn-primary m-1" onclick="run('convert')">Конвертиране</button>
       
        <div id="conversionResult" class="mt-3 p-3 rounded"
             style="background-color: #0d1424;
                    border: 1px solid #35405a;
                    color: #f1f3f9;">

            <span style="color: #aab3c8;">Резултат:</span>

            <strong id="conversionValue" style="margin-left: 15px; color: #a78bfa;">
                Извърши конвертиране
            </strong>

        
            <div class="mt-2" style="color: #aab3c8; font-size: 14px;">
                Актуален курс:
                <span id="currentRate" style="color: #f1f3f9;">
                    —
                </span>
            </div>
        </div>
    </div>

    <section id="charts" class="chart-section mt-4">
        <h4>Сравнение на валутите</h4>
        <p class="text-white-50">Движение на валутните курсове през годините</p>
        <div class="mb-3">
            <button type="button" id="chartOneYear" class="btn btn-outline-light btn-sm">1 година</button>
        </div>
        <div class="mt-3">
            <canvas id="currencyChart"></canvas>
        </div>
        <p id="chartStatus" class="text-white-50 mt-3">Графиката ще се зареди след избор на период.</p>
    </section>

    <section id="historySection" class="chart-section mt-4">
        <h4>История на конвертиранията</h4>
        <p class="text-white-50">Последните извършени валутни конвертирания</p>
        <div id="historyList" class="mt-4">
            <p class="text-white-50">Все още няма заредена история.</p>
        </div>
    </section>

    <h4>Период за анализ</h4>

    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label class="form-label">Начална дата</label>
            <input id="startDate" type="date"
                   class="form-control"
                   value="2026-09-01" />
        </div>

        <div class="col-md-4">
            <label class="form-label">Крайна дата</label>
            <input id="endDate" type="date"
                   class="form-control"
                   value="2026-09-30" />
        </div>
    </div>

    <hr />

    <h4>Функционалности</h4>

    <div class="mb-3">

        <button class="btn btn-secondary m-1"
                onclick="run('history')">
            Последни конвертирания
        </button>

        <button class="btn btn-secondary m-1"
                onclick="run('currencies')">
            Списък с валути
        </button>

        <button class="btn btn-secondary m-1"
                onclick="run('rates')">
            Исторически курсове
        </button>

        <button class="btn btn-secondary m-1"
                onclick="run('trend')">
            Статистика
        </button>

        <button class="btn btn-success m-1"
                onclick="run('ai')">
            Gemini AI анализ
        </button>
    </div>

    <hr />

    <h4>Резултат</h4>

    <pre id="result"
         class="border rounded p-3"
         style="white-space:pre-wrap; overflow-wrap:anywhere; max-height:500px; overflow:auto;">
Избери функционалност от бутоните.
    </pre>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>

<script>
    const api = "/api/Currency";

    const chartStatus = document.getElementById("chartStatus");

    if (typeof Chart !== "undefined") {
        chartStatus.textContent = "Chart.js е зареден успешно.";
    } else {
        chartStatus.textContent = "Chart.js не можа да се зареди.";
    }

    function getValues() {
        return {
            fromCurrency: document.getElementById("fromCurrency").value,
            toCurrency: document.getElementById("toCurrency").value,
            startDate: document.getElementById("startDate").value,
            endDate: document.getElementById("endDate").value
        };
    }

    
    async function sendRequest(url, options = {}) {

        const isConversion = url.endsWith("/convert");

        const output = document.getElementById(
            isConversion ? "conversionValue" : "result"
        );

        output.textContent = "Зареждане...";

        try {
            const response = await fetch(url, options);
            const text = await response.text();

            let data;

            try {
                data = JSON.parse(text);
            } catch {
                data = text;
            }

            if (!response.ok) {
                output.textContent =
                    "HTTP Error: " + response.status +
                    "\n\n" + JSON.stringify(data, null, 2);
                return;
            }

            if (isConversion) {
                const converted = data.convertedAmount
                    ?? data.convertedValue
                    ?? data.result;

                if (converted != null) {
                    const amount = Number(data.amount);

                    output.textContent =
                        `${amount} ${data.fromCurrency} = ` +
                        `${Number(converted).toFixed(2)} ${data.toCurrency}`;

                    const rate = Number(
                        data.rate ??
                        data.exchangeRate ??
                        data.conversionRate ??
                        (Number(converted) / amount)
                    );

                    document.getElementById("currentRate").textContent =
                        `1 ${data.fromCurrency} = ` +
                        `${rate.toFixed(4)} ${data.toCurrency}`;

                } else {
                    output.textContent = JSON.stringify(data, null, 2);
                }

                // Обновяваме историята след успешно конвертиране
                await loadConversionHistory();

                return;
            }

            if (data && data.analysis) {
                output.textContent = data.analysis;
            } else {
                output.textContent =
                    JSON.stringify(data, null, 2);
            }

        } catch (error) {
            output.textContent =
                "Грешка: " + error.message;
        }
    }


    function run(action) {
        const values = getValues();

        const params = new URLSearchParams(values);

        switch (action) {
            case "convert":
                const amount = Number(
                    document.getElementById("amount").value
                );

                if (!Number.isFinite(amount) || amount <= 0) {
                    document.getElementById("result").textContent =
                        "Въведи положителна сума.";
                    return;
                }

                sendRequest(api + "/convert", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        amount: amount,
                        fromCurrency: values.fromCurrency,
                        toCurrency: values.toCurrency
                    })
                });
                break;

            case "history":
                sendRequest(api + "/history");
                break;

            case "currencies":
                sendRequest(api + "/currencies");
                break;

            case "rates":
                sendRequest(api + "/rates/history?" + params);
                break;

            case "trend":
                sendRequest(api + "/trend?" + params);
                break;

            case "ai":
                sendRequest(api + "/trend/analysis?" + params);
                break;
        }
    }

    async function loadCurrencies() {
        try {
            const response = await fetch(api + "/currencies");

            if (!response.ok) return;

            const currencies = await response.json();

            if (!Array.isArray(currencies)) return;

            for (const id of ["fromCurrency", "toCurrency"]) {
                const select = document.getElementById(id);
                const selected = id === "fromCurrency" ? "EUR" : "USD";

                const options = currencies
                    .map(c => ({
                        code: c.iso_code ?? c.isoCode ?? c.code,
                        name: c.name
                    }))
                    .filter(c => c.code)
                    .map(c => new Option(
                        c.code + " - " + (c.name ?? c.code),
                        c.code
                    ));

                select.replaceChildren(...options);
                select.value = selected;
            }
        } catch {
            // Оставяме началните EUR и USD.
        }
    }

    loadCurrencies();

    let historicalChart = null;

   
    async function loadHistoricalChart() {
        const values = getValues();

        // Избираме обща валута за сравнение
        const reference = ["USD", "EUR", "GBP"].find(code => code !== values.fromCurrency && code !== values.toCurrency);

        chartStatus.textContent = "Зареждане на графиката...";

        try {
            async function getRates(currency) {
                const params = new URLSearchParams({
                    fromCurrency: currency,
                    toCurrency: reference,
                    startDate: values.startDate,
                    endDate: values.endDate
                });

                const response = await fetch(
                    `${api}/rates/history?${params}`
                );

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                return await response.json();
            }

            // Зареждаме реалните курсове за двете валути
            const [firstRates, secondRates] = await Promise.all([
                getRates(values.fromCurrency),
                getRates(values.toCurrency)
            ]);

            const secondByDate = new Map(
                secondRates.map(item => [
                    item.date,
                    Number(item.rate)
                ])
            );

            // Сравняваме само датите, налични и за двете
            const points = firstRates
                .map(item => ({
                    date: item.date,
                    first: Number(item.rate),
                    second: secondByDate.get(item.date)
                }))
                .filter(item =>
                    item.date &&
                    Number.isFinite(item.first) &&
                    item.first > 0 &&
                    Number.isFinite(item.second) &&
                    item.second > 0
                )
                .sort((a, b) => a.date.localeCompare(b.date));

            if (historicalChart) {
                historicalChart.destroy();
                historicalChart = null;
            }

            if (points.length === 0) {
                chartStatus.textContent = "Няма данни за периода.";
                return;
            }

            // И двете валути започват от 100
            const firstStart = points[0].first;
            const secondStart = points[0].second;

            historicalChart = new Chart(
                document.getElementById("currencyChart"),
                {
                    type: "line",
                    data: {
                        labels: points.map(item => item.date),
                        datasets: [
                            {
                                label: values.fromCurrency,
                                data: points.map(item =>
                                    item.first / firstStart * 100
                                ),
                                borderColor: "#a78bfa",
                                borderWidth: 2,
                                pointRadius: 0,
                                tension: 0.2
                            },
                            {
                                label: values.toCurrency,
                                data: points.map(item =>
                                    item.second / secondStart * 100
                                ),
                                borderColor: "#f59e0b",
                                borderWidth: 2,
                                pointRadius: 0,
                                tension: 0.2
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: {
                                labels: { color: "#f1f3f9" }
                            }
                        },
                        scales: {
                            x: {
                                ticks: {
                                    color: "#aab3c8",
                                    autoSkip: false,
                                    maxRotation: 0,

                                    callback: function(value, index) {
                                        const lastIndex = this.getLabels().length - 1;
                                        const step = Math.max(1, Math.ceil(lastIndex / 6));

                                        if (index === 0 ||
                                            index === lastIndex ||
                                            index % step === 0) {
                                            return this.getLabelForValue(value);
                                        }

                                        return null;
                                    }
                                }
                            },
                            y: {
                                title: {
                                    display: true,
                                    text: "Индекс (начало = 100)",
                                    color: "#aab3c8"
                                },
                                ticks: { color: "#aab3c8" }
                            }
                        }
                    }
                }
            );

            chartStatus.textContent =
                `Сравнение спрямо ${reference}. ` +
                `Заредени ${points.length} дати.`;

        } catch (error) {
            chartStatus.textContent =
                `Грешка: ${error.message}`;
        }
    }

    loadHistoricalChart();

    document.getElementById("fromCurrency").addEventListener("change", loadHistoricalChart);
    document.getElementById("toCurrency").addEventListener("change", loadHistoricalChart);
    document.getElementById("startDate").addEventListener("change", loadHistoricalChart);
    document.getElementById("endDate").addEventListener("change", loadHistoricalChart);

    
    const chartOneYearButton =
        document.getElementById("chartOneYear");

    if (chartOneYearButton) {
        chartOneYearButton.addEventListener("click", function () {

            const startDateInput =
                document.getElementById("startDate");

            const endDateInput =
                document.getElementById("endDate");

            if (!startDateInput || !endDateInput) {
                console.error("Date inputs were not found.");
                return;
            }

            const end = new Date();

            // Използваме вчерашната дата
            end.setDate(end.getDate() - 1);

            // Начало на периода от 365 дни
            const start = new Date(end);
            start.setDate(start.getDate() - 364);

            function formatDate(date) {
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, "0");
                const day = String(date.getDate()).padStart(2, "0");

                return `${year}-${month}-${day}`;
            }

            startDateInput.value = formatDate(start);
            endDateInput.value = formatDate(end);

            loadHistoricalChart();
        });
    }

    
    async function loadConversionHistory() {
        const historyList = document.getElementById("historyList");

        if (!historyList) return;

        historyList.textContent = "Зареждане на историята...";

        try {
            const response = await fetch(`${api}/history`);

            if (!response.ok) {
                throw new Error(`HTTP ${response.status}`);
            }

            const history = await response.json();

            console.log("Conversion history:", history);

            
        historyList.style.whiteSpace = "normal";
        historyList.replaceChildren();

        if (!Array.isArray(history) || history.length === 0) {
            historyList.textContent = "Все още няма конвертирания.";
            return;
        }

        history.forEach(item => {
            const row = document.createElement("div");
            row.className = "d-flex justify-content-between align-items-center flex-wrap gap-3 py-3";
            row.style.borderBottom = "1px solid #303b55";

            const details = document.createElement("div");

            const amount = document.createElement("div");
            amount.className = "fw-semibold text-white";
            amount.textContent =
                `${Number(item.amount).toLocaleString("bg-BG")} ${item.fromCurrency} → ` +
                `${Number(item.convertedAmount).toLocaleString("bg-BG", { maximumFractionDigits: 2 })} ${item.toCurrency}`;

            const rate = document.createElement("small");
            rate.className = "text-white-50";
            rate.textContent =
                `Курс: 1 ${item.fromCurrency} = ` +
                `${Number(item.exchangeRate).toLocaleString("bg-BG", { maximumFractionDigits: 6 })} ${item.toCurrency}`;

            details.append(amount, document.createElement("br"), rate);

            const date = document.createElement("small");
            date.className = "text-white-50";
            date.textContent = item.convertedAtUtc
                ? item.convertedAtUtc.slice(0, 16).replace("T", " ") + " UTC"
                : "Няма дата";

            row.append(details, date);
            historyList.appendChild(row);
        });


        } catch (error) {
            console.error("History error:", error);

            historyList.textContent =
                `Грешка при зареждане на историята: ${error.message}`;
        }
    }

    loadConversionHistory();


    
</script>
