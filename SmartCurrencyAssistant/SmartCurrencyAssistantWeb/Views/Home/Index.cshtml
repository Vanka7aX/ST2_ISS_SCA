@{ ViewData["Title"] = "Конвертор"; }
<div class="workspace">
    <section class="page-heading"><div><h1>Валутен конвертор</h1><p>Конвертирайте валути и разглеждайте движението на курсовете на едно място.</p></div></section>
    <div class="dashboard-grid">
        <section class="surface converter-section" aria-labelledby="converter-title">
            <div class="section-heading"><div><h2 id="converter-title">Конвертиране</h2><p>Изберете валути и въведете сума.</p></div></div>
            <div class="converter-fields">
                <div><label class="form-label" for="amount">Сума</label><input id="amount" type="text" inputmode="decimal" class="form-control" value="100" maxlength="12" autocomplete="off" /></div>
                <div><label class="form-label" for="fromCurrency">От валута</label><select id="fromCurrency" class="form-select"><option value="EUR">EUR</option><option value="USD">USD</option></select></div>
                <div><label class="form-label" for="toCurrency">Към валута</label><select id="toCurrency" class="form-select"><option value="USD">USD</option><option value="EUR">EUR</option></select></div>
            </div>
            <button type="button" class="btn action-primary" onclick="run('convert')">Конвертирай <span aria-hidden="true">→</span></button>
            <div id="conversionResult" class="conversion-result" aria-live="polite"><span class="result-label">Резултат</span><strong id="conversionValue">Очаква конвертиране</strong><div class="rate-line">Валутен курс: <span id="currentRate">–</span></div></div>
            <button type="button" id="toggleCurrenciesButton" class="text-action" aria-expanded="false" aria-controls="currenciesPanel">Списък с валути <span aria-hidden="true">↗</span></button>
            <div id="currenciesPanel" class="currencies-panel" hidden><h3>Поддържани валути</h3><label class="visually-hidden" for="currencySearch">Търси валута</label><input type="search" id="currencySearch" class="form-control" placeholder="Търси валута..."><div id="currenciesList" class="currencies-list"><p>Зареждане на валутите...</p></div></div>
        </section>
        <section id="charts" class="surface chart-section" aria-labelledby="chart-title">
            <div class="section-heading chart-heading"><div><h2 id="chart-title">Движение на валутите</h2><p>Сравнете представянето за избрания период.</p></div><button type="button" id="chartOneYear" class="btn button-subtle">1 година</button></div>
            <div class="date-fields"><div><label class="form-label" for="startDate">Начална дата</label><input id="startDate" type="date" class="form-control" value="2026-09-01" /></div><div><label class="form-label" for="endDate">Крайна дата</label><input id="endDate" type="date" class="form-control" value="2026-09-30" /></div></div>
            <div class="chart-wrap"><canvas id="currencyChart" aria-label="Графика на валутните курсове" role="img"></canvas></div><p id="chartStatus" class="status-text" aria-live="polite">Зареждане на графиката...</p>
        </section>
    </div>

</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>

<script>
    const api = "/api/Currency";

    const chartStatus = document.getElementById("chartStatus");

    if (typeof Chart !== "undefined") {
        chartStatus.textContent = "Chart.js е зареден успешно.";
    } else {
        chartStatus.textContent = "Chart.js не можа да се зареди.";
    }

    function getValues() {
        return {
            fromCurrency: document.getElementById("fromCurrency").value,
            toCurrency: document.getElementById("toCurrency").value,
            startDate: document.getElementById("startDate").value,
            endDate: document.getElementById("endDate").value
        };
    }

    
    async function sendRequest(url, options = {}) {

        const isConversion = url.endsWith("/convert");

        const output = document.getElementById(
            isConversion ? "conversionValue" : "result"
        );

        output.textContent = "Зареждане...";

        try {
            const response = await fetch(url, options);
            const text = await response.text();

            let data;

            try {
                data = JSON.parse(text);
            } catch {
                data = text;
            }

            if (!response.ok) {
                output.textContent =
                    "HTTP Error: " + response.status +
                    "\n\n" + JSON.stringify(data, null, 2);
                return;
            }

            if (isConversion) {
                const converted = data.convertedAmount
                    ?? data.convertedValue
                    ?? data.result;

                if (converted != null) {
                    const amount = Number(data.amount);

                    output.textContent =
                        `${amount} ${data.fromCurrency} = ` +
                        `${Number(converted).toFixed(2)} ${data.toCurrency}`;

                    const rate = Number(
                        data.rate ??
                        data.exchangeRate ??
                        data.conversionRate ??
                        (Number(converted) / amount)
                    );

                    document.getElementById("currentRate").textContent =
                        `1 ${data.fromCurrency} = ` +
                        `${rate.toFixed(4)} ${data.toCurrency}`;

                } else {
                    output.textContent = JSON.stringify(data, null, 2);
                }

                // Обновяваме историята след успешно конвертиране
                return;
            }

            if (data && data.analysis) {
                output.textContent = data.analysis;
            } else {
                output.textContent =
                    JSON.stringify(data, null, 2);
            }

        } catch (error) {
            output.textContent =
                "Грешка: " + error.message;
        }
    }


    const amountInput = document.getElementById("amount");
    amountInput.addEventListener("input", () => {
        const cleaned = amountInput.value.replace(/[^0-9.,]/g, "");
        const separator = cleaned.search(/[.,]/);
        const whole = (separator < 0 ? cleaned : cleaned.slice(0, separator)).slice(0, 9);
        const fraction = separator < 0 ? "" : cleaned.slice(separator + 1).replace(/[.,]/g, "").slice(0, 2);
        amountInput.value = separator < 0 ? whole : whole + cleaned[separator] + fraction;
    });

    function run(action) {
        const values = getValues();

        const params = new URLSearchParams(values);

        switch (action) {
            case "convert":
                const amount = Number(
                    document.getElementById("amount").value.replace(",", ".")
                );

                if (!Number.isFinite(amount) || amount <= 0) {
                    document.getElementById("conversionValue").textContent = "Моля, въведете валидна сума.";
                    return;
                }

                sendRequest(api + "/convert", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        amount: amount,
                        fromCurrency: values.fromCurrency,
                        toCurrency: values.toCurrency
                    })
                });
                break;

            case "currencies":
                sendRequest(api + "/currencies");
                break;
        }
    }

    async function loadCurrencies() {
        try {
            const response = await fetch(api + "/currencies");

            if (!response.ok) return;

            const currencies = await response.json();

            if (!Array.isArray(currencies)) return;

            for (const id of ["fromCurrency", "toCurrency"]) {
                const select = document.getElementById(id);
                const selected = id === "fromCurrency" ? "EUR" : "USD";

                const options = currencies
                    .map(c => ({
                        code: c.iso_code ?? c.isoCode ?? c.code,
                        name: c.name
                    }))
                    .filter(c => c.code)
                    .map(c => new Option(
                        c.code + " - " + (c.name ?? c.code),
                        c.code
                    ));

                select.replaceChildren(...options);
                select.value = selected;
            }
        } catch {
            // Оставяме началните EUR и USD.
        }
    }

    loadCurrencies();

    let historicalChart = null;

   
    async function loadHistoricalChart() {
        const values = getValues();

        // Избираме обща валута за сравнение
        const reference = ["USD", "EUR", "GBP"].find(code => code !== values.fromCurrency && code !== values.toCurrency);

        chartStatus.textContent = "Зареждане на графиката...";

        try {
            async function getRates(currency) {
                const params = new URLSearchParams({
                    fromCurrency: currency,
                    toCurrency: reference,
                    startDate: values.startDate,
                    endDate: values.endDate
                });

                const response = await fetch(
                    `${api}/rates/history?${params}`
                );

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                return await response.json();
            }

            // Зареждаме реалните курсове за двете валути
            const [firstRates, secondRates] = await Promise.all([
                getRates(values.fromCurrency),
                getRates(values.toCurrency)
            ]);

            const secondByDate = new Map(
                secondRates.map(item => [
                    item.date,
                    Number(item.rate)
                ])
            );

            // Сравняваме само датите, налични и за двете
            const points = firstRates
                .map(item => ({
                    date: item.date,
                    first: Number(item.rate),
                    second: secondByDate.get(item.date)
                }))
                .filter(item =>
                    item.date &&
                    Number.isFinite(item.first) &&
                    item.first > 0 &&
                    Number.isFinite(item.second) &&
                    item.second > 0
                )
                .sort((a, b) => a.date.localeCompare(b.date));

            if (historicalChart) {
                historicalChart.destroy();
                historicalChart = null;
            }

            if (points.length === 0) {
                chartStatus.textContent = "Няма данни за периода.";
                return;
            }

            // И двете валути започват от 100
            const firstStart = points[0].first;
            const secondStart = points[0].second;

            historicalChart = new Chart(
                document.getElementById("currencyChart"),
                {
                    type: "line",
                    data: {
                        labels: points.map(item => item.date),
                        datasets: [
                            {
                                label: values.fromCurrency,
                                data: points.map(item =>
                                    item.first / firstStart * 100
                                ),
                                borderColor: "#a78bfa",
                                borderWidth: 2,
                                pointRadius: 0,
                                tension: 0.2
                            },
                            {
                                label: values.toCurrency,
                                data: points.map(item =>
                                    item.second / secondStart * 100
                                ),
                                borderColor: "#f59e0b",
                                borderWidth: 2,
                                pointRadius: 0,
                                tension: 0.2
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: {
                                labels: { color: "#f1f3f9" }
                            }
                        },
                        scales: {
                            x: {
                                ticks: {
                                    color: "#aab3c8",
                                    autoSkip: false,
                                    maxRotation: 0,

                                    callback: function(value, index) {
                                        const lastIndex = this.getLabels().length - 1;
                                        const step = Math.max(1, Math.ceil(lastIndex / 6));

                                        if (index === 0 ||
                                            index === lastIndex ||
                                            index % step === 0) {
                                            return this.getLabelForValue(value);
                                        }

                                        return null;
                                    }
                                }
                            },
                            y: {
                                title: {
                                    display: true,
                                    text: "Индекс (начало = 100)",
                                    color: "#aab3c8"
                                },
                                ticks: { color: "#aab3c8" }
                            }
                        }
                    }
                }
            );

            chartStatus.textContent =
                `Сравнение спрямо ${reference}. ` +
                `Заредени ${points.length} дати.`;

        } catch (error) {
            chartStatus.textContent =
                `Грешка: ${error.message}`;
        }
    }

    loadHistoricalChart();

    document.getElementById("fromCurrency").addEventListener("change", loadHistoricalChart);
    document.getElementById("toCurrency").addEventListener("change", loadHistoricalChart);
    document.getElementById("startDate").addEventListener("change", loadHistoricalChart);
    document.getElementById("endDate").addEventListener("change", loadHistoricalChart);

    
    const chartOneYearButton =
        document.getElementById("chartOneYear");

    if (chartOneYearButton) {
        chartOneYearButton.addEventListener("click", function () {

            const startDateInput =
                document.getElementById("startDate");

            const endDateInput =
                document.getElementById("endDate");

            if (!startDateInput || !endDateInput) {
                console.error("Date inputs were not found.");
                return;
            }

            const end = new Date();

            // Използваме вчерашната дата
            end.setDate(end.getDate() - 1);

            // Начало на периода от 365 дни
            const start = new Date(end);
            start.setDate(start.getDate() - 364);

            function formatDate(date) {
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, "0");
                const day = String(date.getDate()).padStart(2, "0");

                return `${year}-${month}-${day}`;
            }

            startDateInput.value = formatDate(start);
            endDateInput.value = formatDate(end);

            loadHistoricalChart();
        });
    }
</script>
