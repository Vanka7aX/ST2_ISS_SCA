@{
    ViewData["Title"] = "SmartCurrencyAssistant";
}

<div class="container py-4">
    <h2>SmartCurrencyAssistant</h2>
    <p>Basic Frontend - Backend Testing</p>

    <hr />
    <div class="converter-section">
        <h4>Валутен асистент</h4>
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label class="form-label">От валута</label>
                <select id="fromCurrency" class="form-select">
                    <option value="EUR">EUR</option>
                    <option value="USD">USD</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Към валута</label>
                <select id="toCurrency" class="form-select">
                    <option value="USD">USD</option>
                    <option value="EUR">EUR</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Сума</label>
                <input id="amount" type="number" class="form-control" value="100" min="0.01" step="0.01" />
            </div>
        </div>

        <button class="btn btn-primary m-1" onclick="run('convert')">Конвертиране</button>
       
        <div id="conversionResult" class="mt-3 p-3 rounded"
             style="background-color: #0d1424;
                    border: 1px solid #35405a;
                    color: #f1f3f9;">

            <span style="color: #aab3c8;">Резултат:</span>

            <strong id="conversionValue" style="margin-left: 15px; color: #a78bfa;">
                Извърши конвертиране
            </strong>

        
            <div class="mt-2" style="color: #aab3c8; font-size: 14px;">
                Актуален курс:
                <span id="currentRate" style="color: #f1f3f9;">
                    —
                </span>
            </div>
        </div>
    </div>

    <section id="charts" class="chart-section mt-4 p-4 rounded bg-dark text-white">
        <h4>Сравнение на валутите</h4>
        <p class="text-white-50">Движение на валутните курсове през годините</p>
        <div class="mt-3">
            <canvas id="currencyChart"></canvas>
        </div>
        <p id="chartStatus" class="text-white-50 mt-3">Графиката ще се зареди след избор на период.</p>
    </section>

    <h4>Период за анализ</h4>

    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label class="form-label">Начална дата</label>
            <input id="startDate" type="date"
                   class="form-control"
                   value="2026-09-01" />
        </div>

        <div class="col-md-4">
            <label class="form-label">Крайна дата</label>
            <input id="endDate" type="date"
                   class="form-control"
                   value="2026-09-30" />
        </div>
    </div>

    <hr />

    <h4>Функционалности</h4>

    <div class="mb-3">

        <button class="btn btn-secondary m-1"
                onclick="run('history')">
            Последни конвертирания
        </button>

        <button class="btn btn-secondary m-1"
                onclick="run('currencies')">
            Списък с валути
        </button>

        <button class="btn btn-secondary m-1"
                onclick="run('rates')">
            Исторически курсове
        </button>

        <button class="btn btn-secondary m-1"
                onclick="run('trend')">
            Статистика
        </button>

        <button class="btn btn-success m-1"
                onclick="run('ai')">
            Gemini AI анализ
        </button>
    </div>

    <hr />

    <h4>Резултат</h4>

    <pre id="result"
         class="border rounded p-3"
         style="white-space:pre-wrap; overflow-wrap:anywhere; max-height:500px; overflow:auto;">
Избери функционалност от бутоните.
    </pre>
</div>

<script>
    const api = "/api/Currency";

    function getValues() {
        return {
            fromCurrency: document.getElementById("fromCurrency").value,
            toCurrency: document.getElementById("toCurrency").value,
            startDate: document.getElementById("startDate").value,
            endDate: document.getElementById("endDate").value
        };
    }

    async function sendRequest(url, options = {}) {
        
        const isConversion = url.endsWith("/convert");

        const output = document.getElementById(isConversion ? "conversionValue" : "result");


        output.textContent = "Зареждане...";

        try {
            const response = await fetch(url, options);
            const text = await response.text();

            let data;

            try {
                data = JSON.parse(text);
            } catch {
                data = text;
            }

            if (!response.ok) {
                output.textContent =
                    "HTTP Error: " + response.status +
                    "\n\n" + JSON.stringify(data, null, 2);
                return;
            }
            
           
            if (isConversion) {
                const converted = data.convertedAmount
                    ?? data.convertedValue
                    ?? data.result;

                if (converted != null) {
                    const amount = Number(data.amount);

                    output.textContent =
                        `${amount} ${data.fromCurrency} = ` +
                        `${Number(converted).toFixed(2)} ${data.toCurrency}`;

                    const rate = Number(
                        data.rate ??
                        data.exchangeRate ??
                        data.conversionRate ??
                        (Number(converted) / amount)
                    );

                    document.getElementById("currentRate").textContent =
                        `1 ${data.fromCurrency} = ` +
                        `${rate.toFixed(4)} ${data.toCurrency}`;
                } else {
                    output.textContent = JSON.stringify(data, null, 2);
                }

                return;
            }


            if (data && data.analysis) {
                output.textContent = data.analysis;
            } else {
                output.textContent =
                    JSON.stringify(data, null, 2);
            }
        } catch (error) {
            output.textContent =
                "Грешка: " + error.message;
        }
    }

    function run(action) {
        const values = getValues();

        const params = new URLSearchParams(values);

        switch (action) {
            case "convert":
                const amount = Number(
                    document.getElementById("amount").value
                );

                if (!Number.isFinite(amount) || amount <= 0) {
                    document.getElementById("result").textContent =
                        "Въведи положителна сума.";
                    return;
                }

                sendRequest(api + "/convert", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        amount: amount,
                        fromCurrency: values.fromCurrency,
                        toCurrency: values.toCurrency
                    })
                });
                break;

            case "history":
                sendRequest(api + "/history");
                break;

            case "currencies":
                sendRequest(api + "/currencies");
                break;

            case "rates":
                sendRequest(api + "/rates/history?" + params);
                break;

            case "trend":
                sendRequest(api + "/trend?" + params);
                break;

            case "ai":
                sendRequest(api + "/trend/analysis?" + params);
                break;
        }
    }

    async function loadCurrencies() {
        try {
            const response = await fetch(api + "/currencies");

            if (!response.ok) return;

            const currencies = await response.json();

            if (!Array.isArray(currencies)) return;

            for (const id of ["fromCurrency", "toCurrency"]) {
                const select = document.getElementById(id);
                const selected = id === "fromCurrency" ? "EUR" : "USD";

                const options = currencies
                    .map(c => ({
                        code: c.iso_code ?? c.isoCode ?? c.code,
                        name: c.name
                    }))
                    .filter(c => c.code)
                    .map(c => new Option(
                        c.code + " - " + (c.name ?? c.code),
                        c.code
                    ));

                select.replaceChildren(...options);
                select.value = selected;
            }
        } catch {
            // Оставяме началните EUR и USD.
        }
    }

    loadCurrencies();
</script>
